# `make tfvars` writes terraform.tfvars with your current public IP.
# Required: who may reach the public EKS API endpoint (IAM auth still applies).
api_allowed_cidrs = ["203.0.113.10/32"]

# Recommended: the role you sign in to the AWS Console with, so the EKS Console can show
# nodes and workloads (otherwise only the identity that ran Terraform can see them).
# cluster_admin_principal_arns = ["arn:aws:iam::111122223333:role/Admin"]

# Optional overrides (defaults shown)
# name            = "genai-on-eks"
# region          = "ap-northeast-2"
# enable_efs      = true
# admin_email     = "admin@example.com"
# vllm_models     = { "qwen3-8b-neuron" = true, "deepseek-r1-qwen3-8b-neuron" = true }
# bedrock_models  = { "claude-4.5-sonnet" = "global.anthropic.claude-sonnet-4-5-20250929-v1:0" }
